#!/bin/sh
# Mette davanti al messaggio il numero del commit (#N), contando TUTTI i commit
# del repo (anche quelli arrivati da GitHub o fatti altrove). N coincide con il
# numero build delle Release (git rev-list --count HEAD).
f="$1"
first=$(head -n1 "$f")
case "$first" in
  "#"[0-9]*|Merge*|fixup!*|squash!*|Revert*) exit 0 ;;
esac
n=$(( $(git rev-list --count HEAD 2>/dev/null || echo 0) + 1 ))
printf '#%s %s\n' "$n" "$first" > "$f.tmp"
tail -n +2 "$f" >> "$f.tmp"
mv "$f.tmp" "$f"
